# Template for the local .env file. Copy to .env and fill in real values.
# .env is git-ignored and must never be committed.
# Bot-specific variables are prefixed with the bot's name
# (APPOINTMENT_*, WEIGHT_*).
APPOINTMENT_BOT_TOKEN=
WEIGHT_BOT_TOKEN=
DATABASE_URL=

# Webhook mode only (production) — leave empty for local polling.
# The *_WEBHOOK_SECRET values: any long random string; each becomes part of
# that bot's webhook URL so only Telegram (who knows the full URL) can post
# updates. CRON_SECRET protects the weekly check-in route the same way.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APPOINTMENT_WEBHOOK_SECRET=
WEIGHT_WEBHOOK_SECRET=
CRON_SECRET=
# PUBLIC_URL: the https base URL where wsgi.py is reachable,
# e.g. https://my-bot.onrender.com
PUBLIC_URL=

# Optional: IANA timezone for all user-facing times (storage is always UTC).
# Defaults to America/Sao_Paulo when unset.
BUSINESS_TIMEZONE=

# Optional: numeric Telegram user id allowed to use the admin commands
# (/addslot, /slots, /appointments). Leave empty to disable admin features.
# Find your id by messaging @userinfobot on Telegram.
ADMIN_USER_ID=
