# Template for the local .env file. Copy to .env and fill in real values.
# .env is git-ignored and must never be committed.
BOT_TOKEN=
DATABASE_URL=

# Webhook mode only (production) — leave empty for local polling.
# WEBHOOK_SECRET: any long random string; it becomes part of the webhook URL
# so only Telegram (who knows the full URL) can post updates.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# PUBLIC_URL: the https base URL where wsgi.py is reachable,
# e.g. https://my-bot.onrender.com
PUBLIC_URL=

# Optional: numeric Telegram user id allowed to use the admin commands
# (/addslot, /slots, /appointments). Leave empty to disable admin features.
# Find your id by messaging @userinfobot on Telegram.
ADMIN_USER_ID=
